# ============================================================
# Zwakele Foundation – .htaccess
# ============================================================

# Enable the rewrite engine
RewriteEngine On

# Disable MultiViews – prevents Apache from guessing file extensions
Options -MultiViews

# Prevent directory browsing (for security)
Options -Indexes

# -----------------------------------------------------------------
# 1. CLEAN URLS – internal rewrites (no external redirects)
#    Map /page to /page.php without changing the browser URL.
# -----------------------------------------------------------------

RewriteRule ^about$ about.php [L]
RewriteRule ^what-we-do$ what-we-do.php [L]
RewriteRule ^get-involved$ get-involved.php [L]
RewriteRule ^contact$ contact.php [L]
RewriteRule ^donate$ donate.php [L]
RewriteRule ^events$ events.php [L]
RewriteRule ^gallery$ gallery.php [L]
RewriteRule ^impact$ impact.php [L]
RewriteRule ^news$ news.php [L]
RewriteRule ^partnerships$ partnerships.php [L]
RewriteRule ^resources$ resources.php [L]
RewriteRule ^thank-you$ thank-you.php [L]

# -----------------------------------------------------------------
# 2. DYNAMIC DETAIL PAGES – clean URLs for single news & events
#    /news/slug → news-detail.php?slug=slug
#    /events/id  → event-detail.php?id=id
# -----------------------------------------------------------------

RewriteRule ^news/([a-zA-Z0-9-]+)/?$ news-detail.php?slug=$1 [L]
RewriteRule ^events/([0-9]+)/?$ event-detail.php?id=$1 [L]

# -----------------------------------------------------------------
# 3. ASSET PATH CORRECTION
#    Redirect old /lib/, /css/, /js/ to /assets/ versions.
# -----------------------------------------------------------------

RewriteRule ^lib/(.*)$ assets/lib/$1 [L]
RewriteRule ^css/(.*)$ assets/css/$1 [L]
RewriteRule ^js/(.*)$ assets/js/$1 [L]

# -----------------------------------------------------------------
# 4. IMAGE PATH FALLBACKS
#    Redirect old image folders to new locations or placeholders.
# -----------------------------------------------------------------

# Old /images/team/ → fallback to /images/about/ (or you can create that folder)
RewriteRule ^images/team/(.*)$ images/about/$1 [L]

# Old /images/hero/ → fallback to /images/about/
RewriteRule ^images/hero/(.*)$ images/about/$1 [L]

# (Optional) If you have a default favicon, point old /images/favicon.ico to your actual favicon.
# RewriteRule ^images/favicon.ico$ assets/images/favicon.ico [L]

# -----------------------------------------------------------------
# 5. ENSURE TRAILING SLASH DOES NOT BREAK REWRITES
#    If someone visits /about/ (with slash), strip it and redirect
# -----------------------------------------------------------------

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# -----------------------------------------------------------------
# 6. (OPTIONAL) FORCE HTTPS – uncomment when live on production
# -----------------------------------------------------------------

# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# -----------------------------------------------------------------
# 7. CUSTOM ERROR DOCUMENTS (optional – create these files)
# -----------------------------------------------------------------

# ErrorDocument 404 /404.php
# ErrorDocument 403 /403.php

# ============================================================
# End of .htaccess
# ============================================================